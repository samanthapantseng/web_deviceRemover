{
  "name": "device-remover",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Live camera view in which phones are erased from people's hands. Runs fully on-device in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "models": "bash scripts/fetch_models.sh",
    "copy-ort": "node scripts/copy_ort.mjs",
    "postinstall": "node scripts/copy_ort.mjs",
    "check": "node scripts/headless_check.mjs"
  },
  "dependencies": {
    "@techstark/opencv-js": "^4.12.0-release.1",
    "onnxruntime-web": "^1.31.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
