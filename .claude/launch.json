{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "device-remover",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "device-remover-ipad",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:ipad"
      ],
      "port": 8443,
      "url": "https://localhost:8443"
    },
    {
      "name": "device-remover-test",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    }
  ]
}
